std::vector<{{ gateway_class_name }}Impl::StepData> {{ gateway_class_name }}Impl::getTestSteps() {
    static const std::vector<std::string> kExpectedHeader = {
{% for column in csv_columns %}
        "{{ column }}"{% if not loop.last %},{% endif %}
{% endfor %}
    };

    std::ifstream file("{{ csv_file_path }}");
    if (!file.is_open()) {
        throw std::runtime_error("Failed to open CSV file: {{ csv_file_path }}");
    }

    std::string line;
    if (!std::getline(file, line)) {
        throw std::runtime_error("CSV file is empty: {{ csv_file_path }}");
    }

    validateHeader(splitCsvLine(line), kExpectedHeader);

    std::vector<StepData> steps;
    std::size_t line_number = 1;

    while (std::getline(file, line)) {
        ++line_number;

        if (trimCopy(line).empty()) {
            continue;
        }

        const std::vector<std::string> fields = splitCsvLine(line);
        if (fields.size() != kExpectedHeader.size()) {
            throw std::runtime_error(
                "CSV row column count mismatch at line " +
                std::to_string(line_number) + ". Expected " +
                std::to_string(kExpectedHeader.size()) + ", got " +
                std::to_string(fields.size()));
        }

        StepData step{};
        step.{{ timestamp_field_name }} =
            parseRequiredNumber<{{ timestamp_cpp_type }}>(
                fields[0],
                "timestamp",
                line_number);

{% for member in step_members %}
        {
            const bool {{ member.member_name }}_all_empty =
{% for field in member.fields %}
                trimCopy(fields[{{ field.column_index }}]).empty(){% if not loop.last %} &&
{% else %};{% endif %}
{% endfor %}

            const bool {{ member.member_name }}_any_empty =
{% for field in member.fields %}
                trimCopy(fields[{{ field.column_index }}]).empty(){% if not loop.last %} ||
{% else %};{% endif %}
{% endfor %}

            if ({{ member.member_name }}_all_empty) {
                step.{{ member.member_name }} = std::nullopt;
            } else {
                if ({{ member.member_name }}_any_empty) {
                    throw std::runtime_error(
                        "Partial CSV fill for struct '{{ member.member_name }}' at line " +
                        std::to_string(line_number));
                }

                {{ member.cpp_type }} value{};
{% for field in member.fields %}
                value.{{ field.name }} =
                    parseRequiredNumber<{{ field.cpp_type }}>(
                        fields[{{ field.column_index }}],
                        "{{ field.csv_column_name }}",
                        line_number);
{% endfor %}
                step.{{ member.member_name }} = value;
            }
        }

{% endfor %}
        steps.push_back(step);
    }

    return steps;
}
